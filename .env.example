# Скопируйте в .env и поменяйте значения. docker compose подхватывает .env автоматически.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_PORT=8000

POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345

# Демо-данные (если реальные файлы не заданы)
LOAD_DEMO_DATA=1
DEMO_ROWS=30000

# Реальный датасет: положите файлы в ./data и укажите имена
SALES_FILE=
MACRO_FILE=
MACRO_SHEET=

# Готовый образ для режима `--profile image`
APP_IMAGE=ghcr.io/OWNER/astra-procurement:latest
